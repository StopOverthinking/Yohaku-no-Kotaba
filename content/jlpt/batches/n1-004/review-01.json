  "corrections": [
    {
      "wordId": "lex-jmdict-1177830",
      "category": "clarity",
      "note": "岸을 강가로 한정하지 않도록 물가로 옮겼다."
    },
    {
      "wordId": "lex-jmdict-1177930",
      "category": "substantive",
      "note": "回り道의 다리 공사 우회 장면과 겹쳐 벚꽃을 보기 위해 돌아가는 장면으로 바꿨다."
    },
    {
      "wordId": "lex-jmdict-1192860",
      "category": "clarity",
      "note": "水平線の果て의 모호한 공간 표현을 길의 끝에 대한 상상으로 명확히 했다."
    },
    {
      "wordId": "lex-jmdict-1196520",
      "category": "substantive",
      "note": "기존 안개가 걷히며 산이 보이는 장면과 분리해 눈이 침침해지는 사전 용례로 바꿨다."
    },
    {
      "wordId": "lex-jmdict-1199970",
      "category": "substantive",
      "note": "창문으로 들어오는 쾌적한 바람의 반복을 피해 나무 바닥의 감촉을 사용했다."
    },
    {
      "wordId": "lex-jmdict-1202710",
      "category": "substantive",
      "note": "イベント의 우천 다음 주 연기와 같은 장면을 온라인 학회 개최 결정으로 바꿨다."
    },
    {
      "wordId": "lex-jmdict-1188330",
      "category": "clarity",
      "note": "何しろ의 이유 설명 기능이 드러나도록 한국어 문장 종결을 다듬었다."
    }
  ]
