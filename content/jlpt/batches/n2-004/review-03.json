  "corrections": [
    {
      "wordId": "lex-jmdict-1350710",
      "category": "substantive",
      "note": "焦げる의 전화 중 음식 태우기와 겹쳐 캐러멜 만들기로 변경하고 힌트에 갈색으로 태우는 범위 포함."
    },
    {
      "wordId": "lex-jmdict-1365420",
      "category": "substantive",
      "note": "親戚의 먼 친척 모임 장면과 겹쳐 엽서로 주소 변경 알리기로 변경."
    },
    {
      "wordId": "lex-jmdict-1360920",
      "category": "clarity",
      "note": "반복되는 이해하고 유념하고를 문맥에 맞는 숙지하고로 정리."
    },
    {
      "wordId": "lex-jmdict-1370370",
      "category": "substantive",
      "note": "기존 식물·벌레의 이름을 도감에서 찾는 장면을 반복하지 않도록 그림 설명 방식으로 변경."
    },
    {
      "wordId": "lex-jmdict-1353410",
      "category": "clarity",
      "note": "상순과 하순의 범위를 정확한 날짜로 명시."
    },
    {
      "wordId": "lex-jmdict-1356930",
      "category": "substantive",
      "note": "기존 蓋의 냄비 뚜껑에서 김을 빼는 장면과 겹쳐 스팀 다리미로 변경."
    }
  ]
