{
  "name": "yohaku-no-kotaba",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/StopOverthinking/Yohaku-no-Kotaba.git"
  },
  "homepage": "https://stopoverthinking.github.io/Yohaku-no-Kotaba/",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/generate-vocab-data.mjs",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/generate-vocab-data.mjs && node scripts/audit-jlpt-expansion.mjs",
    "preview": "vite preview",
    "extract:vocab": "node scripts/generate-vocab-data.mjs",
    "test": "vitest run",
    "jlpt:prepare": "python scripts/prepare-jlpt-candidates.py",
    "jlpt:pilot": "node scripts/build-jlpt-pilot.mjs",
    "jlpt:accept": "node scripts/accept-jlpt-batch.mjs",
    "jlpt:audit": "node scripts/audit-jlpt-expansion.mjs",
    "audit:content": "node scripts/audit-learn-content.mjs --require-complete",
    "hint:scan": "node scripts/scan-hint-confusions.mjs",
    "hint:audit": "node scripts/build-hint-confusions.mjs",
    "release:manifest": "node scripts/write-release-manifest.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.15.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "kuromoji": "^0.1.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.2"
  }
}
